root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{tex,bib,md}]
max_line_length = off

[*.py]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
